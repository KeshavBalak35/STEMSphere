  "components": {
    "schemas": {
      "Docking": {
        "properties": {
          "smiles": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Smiles"
          },
          "conformers": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Conformers",
            "default": 5
          },
          "seed": {
            "type": "integer",
            "maximum": 2147483647.0,
            "minimum": 1.0,
            "title": "Seed",
            "default": 42
          },
          "receptor_pdbqt": {
            "type": "string",
            "maxLength": 2000000,
            "minLength": 50,
            "title": "Receptor Pdbqt"
          },
          "center_angstrom": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 3,
            "minItems": 3,
            "title": "Center Angstrom"
          },
          "box_angstrom": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 3,
            "minItems": 3,
            "title": "Box Angstrom",
            "default": [
              20,
              20,
              20
            ]
          },
          "exhaustiveness": {
            "type": "integer",
            "maximum": 32.0,
            "minimum": 1.0,
            "title": "Exhaustiveness",
            "default": 8
          },
          "poses": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Poses",
            "default": 5
          },
          "preparation_notes": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 10,
            "title": "Preparation Notes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "smiles",
          "receptor_pdbqt",
          "center_angstrom",
          "preparation_notes"
        ],
        "title": "Docking"
      },
      "Evidence": {
        "properties": {
          "observed": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 2,
            "title": "Observed"
          },
          "predicted": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 2,
            "title": "Predicted"
          },
          "sigma": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 2,
            "title": "Sigma"
          },
          "modality": {
            "type": "string",
            "enum": [
              "nmr_ppm",
              "ir_cm-1"
            ],
            "title": "Modality"
          },
          "assignment_provenance": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 5,
            "title": "Assignment Provenance"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "observed",
          "predicted",
          "sigma",
          "modality",
          "assignment_provenance"
        ],
        "title": "Evidence"
      },
      "Guide": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Question"
          },
          "job_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Job Id"
          },
          "use_external_ai": {
            "type": "boolean",
            "title": "Use External Ai",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "Guide"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Molecule": {
        "properties": {
          "smiles": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Smiles"
          },
          "conformers": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Conformers",
            "default": 5
          },
          "seed": {
            "type": "integer",
            "maximum": 2147483647.0,
            "minimum": 1.0,
            "title": "Seed",
            "default": 42
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "smiles"
        ],
        "title": "Molecule"
      },
      "Quantum": {
        "properties": {
          "smiles": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Smiles"
          },
          "conformers": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Conformers",
            "default": 5
          },
          "seed": {
            "type": "integer",
            "maximum": 2147483647.0,
            "minimum": 1.0,
            "title": "Seed",
            "default": 42
          },
          "task": {
            "type": "string",
            "enum": [
              "orbitals",
              "ir",
              "nmr"
            ],
            "title": "Task",
            "default": "orbitals"
          },
          "method": {
            "type": "string",
            "enum": [
              "HF",
              "B3LYP",
              "PBE0"
            ],
            "title": "Method",
            "default": "B3LYP"
          },
          "basis": {
            "type": "string",
            "enum": [
              "sto-3g",
              "def2-svp",
              "def2-tzvp"
            ],
            "title": "Basis",
            "default": "def2-svp"
          },
          "optimize": {
            "type": "boolean",
            "title": "Optimize",
            "default": true
          },
          "displacement_bohr": {
            "type": "number",
            "maximum": 0.02,
            "minimum": 0.001,
            "title": "Displacement Bohr",
            "default": 0.005
          },
          "reference_shielding_ppm": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Reference Shielding Ppm"
          },
          "reference_provenance": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference Provenance"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "smiles"
        ],
        "title": "Quantum"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}